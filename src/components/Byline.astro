---
import { link } from '../lib/path';
import {
  DEFAULT_LANG,
  LANGUAGES,
  SITE_COPY,
  localizedPath,
  type Lang,
} from '../lib/i18n';

type Props = {
  author: string;
  publishDate: Date;
  readingTime?: string;
  authorHref?: string;
  lang?: Lang;
};

const { author, publishDate, readingTime, lang = DEFAULT_LANG, authorHref } =
  Astro.props;
const resolvedAuthorHref = authorHref ?? link(localizedPath('/about', lang));

const formatter = new Intl.DateTimeFormat(LANGUAGES[lang].dateLocale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const human = formatter.format(publishDate);
const iso = publishDate.toISOString();
const copy = SITE_COPY[lang];
---

<address class="byline">
  {copy.byline.by} <a href={resolvedAuthorHref} rel="author">{author}</a>
  <span class="byline__sep">·</span>
  <time datetime={iso}>{human}</time>
  {readingTime && (
    <>
      <span class="byline__sep">·</span>
      <span>{readingTime}</span>
    </>
  )}
</address>

<style>
  .byline {
    font-style: normal;
    font-size: 0.95rem;
    color: var(--color-ink-soft);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em;
    align-items: baseline;
  }

  .byline a {
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--color-rule);
  }
  .byline a:hover {
    border-bottom-color: var(--color-accent);
    color: var(--color-accent);
  }

  .byline__sep {
    color: var(--color-ink-muted);
  }
</style>
