---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ReviewCard from '../../../components/ReviewCard.astro';
import { readingTime } from '../../../lib/reading-time';
import { link } from '../../../lib/path';
import {
  SITE_COPY,
  pageAlternatePaths,
  reviewPath,
  reviewsForLang,
} from '../../../lib/i18n';

const all = await getCollection('reviews', ({ data }) => !data.draft);
const lang = 'is';
const copy = SITE_COPY[lang];
const sorted = reviewsForLang(all, lang);
---

<BaseLayout
  title={copy.reviews.title}
  description={copy.reviews.description}
  type="website"
  lang={lang}
  alternatePaths={pageAlternatePaths('/reviews')}
>
  <section class="reviews-index container-narrow">
    <header class="reviews-index__header">
      <p class="eyebrow">{copy.reviews.eyebrow}</p>
      <h1>{copy.reviews.title}</h1>
      <p class="reviews-index__count">
        {copy.reviews.count(sorted.length)}
      </p>
    </header>

    <div class="reviews-index__list">
      {sorted.map((entry) => (
        <ReviewCard
          href={link(reviewPath(entry))}
          title={entry.data.title}
          description={entry.data.description}
          publishDate={entry.data.publishDate}
          readingTime={readingTime(entry.body ?? '', lang)}
          rating={entry.data.rating}
          productCategory={entry.data.productCategory}
          lang={lang}
        />
      ))}

      {sorted.length === 0 && (
        <p>{copy.reviews.empty}</p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .reviews-index {
    padding-block: var(--space-7) var(--space-8);
  }

  .reviews-index__header {
    margin-bottom: var(--space-6);
  }

  .reviews-index__header .eyebrow {
    margin-bottom: var(--space-3);
  }

  .reviews-index__header h1 {
    font-family: var(--font-display);
    font-weight: 500;
    margin: 0 0 var(--space-3) 0;
  }

  .reviews-index__count {
    color: var(--color-ink-soft);
  }
</style>
