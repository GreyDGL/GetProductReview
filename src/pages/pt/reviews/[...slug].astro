---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import ReviewLayout from '../../../layouts/ReviewLayout.astro';
import { link } from '../../../lib/path';
import {
  getReviewSlug,
  reviewAlternatePaths,
  reviewPath,
} from '../../../lib/i18n';

export async function getStaticPaths() {
  const all = await getCollection('reviews', ({ data }) => !data.draft);
  const reviews = all.filter((entry) => entry.data.lang === 'pt');
  return reviews.map((entry) => ({
    params: { slug: getReviewSlug(entry) },
    props: { entry, alternatePaths: reviewAlternatePaths(entry, all) },
  }));
}

type Props = {
  entry: CollectionEntry<'reviews'>;
  alternatePaths: ReturnType<typeof reviewAlternatePaths>;
};

const { entry, alternatePaths } = Astro.props as Props;
const { Content } = await render(entry);
const lang = 'pt';
const url = link(reviewPath(entry));
---

<ReviewLayout entry={entry} url={url} lang={lang} alternatePaths={alternatePaths}>
  <Content />
</ReviewLayout>
