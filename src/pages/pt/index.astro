---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchemaOrg from '../../components/SchemaOrg.astro';
import ReviewCard from '../../components/ReviewCard.astro';
import { readingTime } from '../../lib/reading-time';
import { SITE } from '../../lib/site';
import { link } from '../../lib/path';
import {
  SITE_COPY,
  pageAlternatePaths,
  reviewPath,
  reviewsForLang,
} from '../../lib/i18n';

const all = await getCollection('reviews', ({ data }) => !data.draft);
const lang = 'pt';
const copy = SITE_COPY[lang];
const sorted = reviewsForLang(all, lang);

const featured = sorted[0];
const rest = sorted.slice(1, 6);
---

<BaseLayout
  title="Análises de produtos honestas e testadas na prática"
  description={copy.description}
  type="website"
  lang={lang}
  alternatePaths={pageAlternatePaths('/')}
>
  <SchemaOrg slot="head" type="website" lang={lang} />

  <section class="hero container-narrow">
    <p class="eyebrow">{SITE.title}</p>
    <h1 class="hero__headline">
      {copy.tagline}
    </h1>
    <p class="hero__lede">
      {copy.description}
    </p>
  </section>

  <section class="latest container">
    {featured && (
      <ReviewCard
        featured
        href={link(reviewPath(featured))}
        title={featured.data.title}
        description={featured.data.description}
        publishDate={featured.data.publishDate}
        readingTime={readingTime(featured.body ?? '', lang)}
        rating={featured.data.rating}
        productCategory={featured.data.productCategory}
        lang={lang}
      />
    )}

    {rest.length > 0 && (
      <div class="latest__list">
        <p class="eyebrow latest__heading">{copy.index.moreReviews}</p>
        {rest.map((entry) => (
          <ReviewCard
            href={link(reviewPath(entry))}
            title={entry.data.title}
            description={entry.data.description}
            publishDate={entry.data.publishDate}
            readingTime={readingTime(entry.body ?? '', lang)}
            rating={entry.data.rating}
            productCategory={entry.data.productCategory}
            lang={lang}
          />
        ))}
      </div>
    )}

    {sorted.length === 0 && (
      <p class="latest__empty" set:html={copy.index.empty.replaceAll('href="/', `href="${link('/')}`)} />
    )}

    {sorted.length > 6 && (
      <p class="latest__more">
        <a href={link('/pt/reviews')}>{copy.index.seeAll}</a>
      </p>
    )}
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-8) var(--space-7);
  }

  .hero .eyebrow {
    margin-bottom: var(--space-4);
  }

  .hero__headline {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 4.5vw + 0.5rem, 4rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-4) 0;
    max-width: 18ch;
  }

  .hero__lede {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-style: italic;
    color: var(--color-ink-soft);
    line-height: 1.5;
    max-width: 36em;
  }

  .latest {
    padding-bottom: var(--space-8);
  }

  .latest__list {
    margin-top: var(--space-7);
  }

  .latest__heading {
    margin-bottom: var(--space-4);
  }

  .latest__empty {
    color: var(--color-ink-soft);
  }

  .latest__more {
    margin-top: var(--space-5);
  }

  .latest__more a {
    font-family: var(--font-body);
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid var(--color-accent);
    padding-bottom: 1px;
  }
</style>
